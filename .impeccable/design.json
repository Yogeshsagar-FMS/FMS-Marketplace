  "narrative": {
    "northStar": "Campus publication, everyday exchange",
    "overview": "An everyday campus exchange with the character of an independent university publication. Forest ink, warm paper, vermilion accents, and a serif/sans pairing give useful secondhand belongings an editorial frame. The university cultural-festival direction lands through its confident print palette and circular exchange mark; the marketplace keeps familiar search, filters, cards, and forms.\n\nThe system is photographic and restrained: still-life imagery leads, product facts remain easy to compare, and thin rules separate information without enclosing every item. Keep the FMS Circle identity and a clear FMS Delhi context. The browser-local prototype labels demonstration inventory and illustrative generated photography; it does not imply verified students or shared activity. Avoid the previous Pinterest/polaroid treatment and generic ecommerce dashboard language.",
    "keyCharacteristics": [
      "Editorial serif headlines beside practical sans-serif controls.",
      "Warm paper, forest ink, and selective vermilion action.",
      "Photographic wells, flat cards, and thin separating rules.",
      "A circular exchange mark and compact, responsive inventory.",
      "Visible pickup facts and immediate keyboard feedback."
    ],
    "rules": [
      {
        "name": "The Selective Vermilion Rule",
        "body": "Reserve the accent for actions, emphasis, saved state, and focus; do not turn every inventory fact into an accent.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Keep editorial headings and prices in the serif; keep item identification, controls, and factual metadata in the sans.",
        "section": "typography"
      },
      {
        "name": "The Flat Inventory Rule",
        "body": "Keep the card body unboxed and shadowless; reserve elevation for overlays and the small exchange stamp.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use warm paper, forest ink, and selective vermilion with the self-hosted serif/sans pairing.",
      "**Do** preserve photographic wells and flat card bodies with quiet rules.",
      "**Do** keep condition, price, seller, and wrapping pickup visible when comparing items on mobile.",
      "**Do** maintain visible keyboard focus through saves, removals, and dialog transitions.",
      "**Do** label sample listings and explain browser-only persistence and illustrative photography."
    ],
    "donts": [
      "**Don't** reintroduce the Pinterest/polaroid layout or a generic ecommerce dashboard.",
      "**Don't** add card shadows or use mint as a fabricated success/verification signal.",
      "**Don't** move detail taxonomy above the heading as a decorative eyebrow.",
      "**Don't** imply verified accounts, shared marketplace activity, payments, or private messages in this local prototype.",
