  "narrative": {
    "northStar": "FMS. Full circle.",
    "overview": "An expressive student exchange grounded in FMS Delhi: deep maroon, butter yellow, ivory paper and oversized Bricolage Grotesque lettering. The sourced eagle identity and familiar campus belongings establish place; rotated poster compositions and moving photographic cutouts bring the energy of a student festival programme to an everyday handover.\n\nThe user explicitly rejected the restrained forest/serif catalogue. This replacement identity is bold, playful and animated while keeping item comparison and listing practical. The FMS Circle name remains; institutional imagery identifies the campus without claiming an official service. Sample listings and generated photography remain clearly disclosed.",
    "keyCharacteristics": [
      "Oversized grotesque lettering with practical DM Sans controls.",
      "Maroon fields, butter highlights and warm paper inventory.",
      "Rotated posters and photographic cutouts with soft object depth.",
      "Flat listing bodies with visible price, condition and pickup.",
      "Pausable decorative motion and complete reduced-motion states."
    ],
    "rules": [
      {
        "name": "The Campus Color Rule",
        "body": "Use maroon and butter as substantial identity fields as well as action colors; keep inventory facts readable on warm paper.",
        "section": "colors"
      },
      {
        "name": "The Oversized Voice Rule",
        "body": "Let expressive headings occupy the available width; preserve the shipped oversized display scale rather than imposing the former catalogue cap.",
        "section": "typography"
      },
      {
        "name": "The Object Depth Rule",
        "body": "Give photographic cutouts soft depth and movement while keeping listing card bodies flat and shadowless.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** carry maroon, butter and the self-hosted Bricolage Grotesque / DM Sans pairing across new surfaces.",
      "**Do** keep cutout imagery, poster composition and motion grounded in real campus belongings.",
      "**Do** keep price, condition, seller and wrapping pickup visible on mobile.",
      "**Do** provide visible focus, immediate keyboard response, a motion pause control and reduced-motion support.",
      "**Do** keep institutional identity, motion controls and prototype notices readable on phones."
    ],
    "donts": [
      "**Don't** return to the rejected forest/serif restrained catalogue or a generic ecommerce dashboard.",
      "**Don't** shrink expressive display typography to an arbitrary 6rem maximum.",
      "**Don't** turn metadata into decorative eyebrows or add hard offset shadows outside this visual world.",
